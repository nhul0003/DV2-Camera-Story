{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Box plots with overview and detail: megapixels of new digital camera models by year, 1996-2025. Drag across the small chart to zoom the box plots.",
  "title": {
    "text": "Megapixels of new camera models",
    "subtitle": "One box per year · small chart: median megapixels · 1996 to 2025"
  },
  "data": {"url": "data/cameras.csv", "format": {"parse": {"year": "number", "megapixels": "number"}}},
  "transform": [{"filter": "datum.year >= 1996"}],
  "spacing": 20,
  "vconcat": [
    {
      "width": 628,
      "height": 300,
      "transform": [{"filter": {"param": "brush"}}],
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": null,
          "axis": {
            "labelAngle": 0,
            "labelPadding": 8,
            "labelExpr": "datum.value % 5 == 0 ? datum.label : ''",
            "grid": false
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "boxplot",
            "extent": 1.5,
            "size": 13,
            "color": "#64ADB6",
            "median": {"color": "#FAF8F3", "strokeWidth": 2},
            "rule": {"color": "#8FBFC5"},
            "ticks": false,
            "outliers": {"size": 10, "opacity": 0.5, "color": "#64ADB6"}
          },
          "encoding": {
            "y": {
              "field": "megapixels",
              "type": "quantitative",
              "title": "Megapixels",
              "scale": {"domain": [0, 80]},
              "axis": {
                "values": [0, 10, 20, 30, 40, 50, 60],
                "grid": true,
                "gridColor": "#ECE8DF",
                "titleFontWeight": 600,
                "titleColor": "#6B6B6B",
                "minExtent": 40
              }
            }
          }
        },
        {
          "transform": [{"filter": "datum.year == 2000 || datum.year == 2010 || datum.year == 2019"}],
          "mark": {
            "type": "boxplot",
            "extent": 1.5,
            "size": 13,
            "color": "#0B4A52",
            "median": {"color": "#FAF8F3", "strokeWidth": 2},
            "rule": {"color": "#0B4A52"},
            "ticks": false,
            "outliers": false
          },
          "encoding": {"y": {"field": "megapixels", "type": "quantitative", "scale": {"domain": [0, 80]}, "title": null}}
        },
        {
          "transform": [
            {"filter": "datum.year == 2000 || datum.year == 2010 || datum.year == 2019"},
            {"aggregate": [{"op": "median", "field": "megapixels", "as": "med"}], "groupby": ["year"]},
            {"calculate": "datum.year + ': ' + format(datum.med, '.0f') + ' MP'", "as": "label"},
            {"calculate": "67", "as": "ypos"}
          ],
          "mark": {"type": "text", "fontSize": 13, "fontWeight": 700, "color": "#0B4A52"},
          "encoding": {
            "y": {"field": "ypos", "type": "quantitative", "scale": {"domain": [0, 80]}, "title": null},
            "text": {"field": "label"}
          }
        },
        {
          "data": {"values": [{"k": 1}]},
          "layer": [
            {
              "mark": {"type": "rule", "color": "#8FBFC5", "strokeWidth": 1},
              "encoding": {"x": {"value": 6}, "y": {"value": 2}, "y2": {"value": 20}}
            },
            {
              "mark": {"type": "rect", "color": "#64ADB6"},
              "encoding": {"x": {"value": 0}, "x2": {"value": 13}, "y": {"value": 6}, "y2": {"value": 16}}
            },
            {
              "mark": {"type": "rule", "color": "#FAF8F3", "strokeWidth": 2},
              "encoding": {"x": {"value": 0}, "x2": {"value": 13}, "y": {"value": 11}}
            },
            {
              "mark": {
                "type": "text",
                "align": "left",
                "baseline": "middle",
                "fontSize": 12,
                "color": "#3A3A3A",
                "text": "Box: middle half of that year's models · pale line: median · whiskers: usual range"
              },
              "encoding": {"x": {"value": 20}, "y": {"value": 11}}
            },
            {
              "mark": {"type": "circle", "size": 20, "opacity": 0.6, "color": "#64ADB6"},
              "encoding": {"x": {"value": 478}, "y": {"value": 11}}
            },
            {
              "mark": {
                "type": "text",
                "align": "left",
                "baseline": "middle",
                "fontSize": 12,
                "color": "#3A3A3A",
                "text": "Dot: unusual model"
              },
              "encoding": {"x": {"value": 486}, "y": {"value": 11}}
            }
          ]
        }
      ]
    },
    {
      "width": 628,
      "height": 60,
      "transform": [{"aggregate": [{"op": "median", "field": "megapixels", "as": "med"}], "groupby": ["year"]}],
      "params": [{"name": "brush", "select": {"type": "interval", "encodings": ["x"]}}],
      "mark": {
        "type": "area",
        "color": "#A9D3D8",
        "line": {"color": "#1B7F8C", "strokeWidth": 1.5},
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": null,
          "scale": {"domain": [1996, 2025], "nice": false},
          "axis": {"format": "d", "values": [2000, 2005, 2010, 2015, 2020, 2025], "labelPadding": 6, "grid": false}
        },
        "y": {
          "field": "med",
          "type": "quantitative",
          "title": "Median",
          "scale": {"domain": [0, 30]},
          "axis": {"values": [0, 25], "grid": false, "titleFontWeight": 600, "titleColor": "#6B6B6B", "minExtent": 40}
        },
        "tooltip": [
          {"field": "year", "type": "ordinal", "title": "Year"},
          {"field": "med", "type": "quantitative", "title": "Median megapixels", "format": ".1f"}
        ]
      }
    }
  ],
  "config": {
    "background": null,
    "view": {"stroke": null},
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "axis": {"domain": false, "ticks": false, "labelColor": "#4A4A4A", "labelFontSize": 13},
    "title": {
      "anchor": "start",
      "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "fontSize": 19,
      "fontWeight": 700,
      "color": "#1F1F1F",
      "subtitleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "subtitleFontSize": 14,
      "subtitleColor": "#6B6B6B",
      "subtitlePadding": 4,
      "offset": 14
    }
  },
  "padding": {"left": 0, "right": 8, "top": 5, "bottom": 5}
}