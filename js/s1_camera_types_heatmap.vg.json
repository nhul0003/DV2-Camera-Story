{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Heatmap: share of each decade's cameras in the Science Museum Group collection, by camera type (rows) and decade made (columns), 1880s-2000s.",
  "width": "container",
  "height": 390,
  "autosize": {"type": "fit-x", "contains": "padding"},
  "padding": {"left": 0, "right": 8, "top": 5, "bottom": 5},
  "data": {"url": "data/s1_camera_types.csv"},
  "transform": [
    {
      "calculate": "datum.camera_type == 'Pocket & cartridge' ? 'Pocket' : datum.camera_type",
      "as": "camera_type"
    },
    {"calculate": "floor(datum.year_made / 10) * 10", "as": "decade"},
    {"filter": "datum.year_made >= 1880 && datum.year_made < 2010"},
    {"aggregate": [{"op": "count", "as": "cameras"}], "groupby": ["camera_type", "decade"]},
    {"joinaggregate": [{"op": "sum", "field": "cameras", "as": "decade_total"}], "groupby": ["decade"]},
    {"calculate": "datum.cameras / datum.decade_total", "as": "share"},
    {"calculate": "datum.decade + 's'", "as": "decade_label"},
    {
      "calculate": "datum.camera_type == 'Roll film' && datum.decade == 1910 ? 'Roll film at its peak. It was the most common type in every decade from the 1900s to the 1930s.' : datum.camera_type == '35mm' && datum.decade == 1960 ? 'The most common camera of the 1960s. 35mm film became the standard for family cameras.' : datum.camera_type == 'Digital' && datum.decade == 1990 ? 'The darkest square on the chart: in its first decade, digital was already two-thirds of the collection.' : ''",
      "as": "insight"
    },
    {
      "calculate": "datum.share < 0.05 ? 'Under 5%' : datum.share < 0.15 ? '5–14%' : datum.share < 0.30 ? '15–29%' : datum.share < 0.50 ? '30–49%' : '50% or more'",
      "as": "band"
    }
  ],
  "layer": [
    {
      "mark": {"type": "rect", "stroke": "#FAF8F3", "strokeWidth": 2, "cornerRadius": 3},
      "encoding": {
        "x": {
          "field": "decade",
          "type": "ordinal",
          "title": null,
          "scale": {"domain": [1880, 1890, 1900, 1910, 1920, 1930, 1940, 1950, 1960, 1970, 1980, 1990, 2000]},
          "axis": {"labelExpr": "datum.value + 's'", "labelAngle": 0, "orient": "bottom"}
        },
        "y": {
          "field": "camera_type",
          "type": "nominal",
          "title": null,
          "sort": [
            "Plate & field",
            "Stereo",
            "Box",
            "Folding",
            "Reflex",
            "Roll film",
            "Movie (cine)",
            "Miniature",
            "35mm",
            "Compact",
            "Pocket",
            "Instant",
            "Digital",
            "Disposable"
          ],
          "axis": {"minExtent": 110, "labelLimit": 110}
        },
        "color": {
          "field": "band",
          "type": "ordinal",
          "title": "Share of the decade's cameras",
          "scale": {
            "domain": ["Under 5%", "5–14%", "15–29%", "30–49%", "50% or more"],
            "range": ["#E3E7EE", "#B8C2D3", "#8797B2", "#56688C", "#2C3A5A"]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "offset": 16,
            "columns": 5,
            "symbolType": "square",
            "symbolSize": 180,
            "labelFontSize": 13,
            "titleFontSize": 13,
            "columnPadding": 18,
            "titleLimit": 320
          }
        },
        "tooltip": [
          {"field": "camera_type", "type": "nominal", "title": "Camera type"},
          {"field": "decade_label", "type": "nominal", "title": "Decade made"},
          {"field": "cameras", "type": "quantitative", "title": "Cameras"},
          {"field": "share", "type": "quantitative", "title": "Share of decade", "format": ".0%"}
        ]
      }
    },
    {
      "mark": {"type": "rect", "fill": "transparent", "stroke": "#1F1F1F", "strokeWidth": 2, "cornerRadius": 3},
      "encoding": {
        "x": {"field": "decade", "type": "ordinal"},
        "y": {
          "field": "camera_type",
          "type": "nominal",
          "sort": [
            "Plate & field",
            "Stereo",
            "Box",
            "Folding",
            "Reflex",
            "Roll film",
            "Movie (cine)",
            "Miniature",
            "35mm",
            "Compact",
            "Pocket",
            "Instant",
            "Digital",
            "Disposable"
          ]
        },
        "tooltip": [
          {"field": "camera_type", "type": "nominal", "title": "Camera type"},
          {"field": "decade_label", "type": "nominal", "title": "Decade made"},
          {"field": "cameras", "type": "quantitative", "title": "Cameras"},
          {"field": "share", "type": "quantitative", "title": "Share of decade", "format": ".0%"},
          {"field": "insight", "type": "nominal", "title": "What this shows"}
        ]
      },
      "transform": [{"filter": "datum.insight != ''"}]
    },
    {
      "transform": [
        {"filter": "datum.insight != ''"},
        {
          "calculate": "datum.camera_type == 'Roll film' ? '1' : datum.camera_type == '35mm' ? '2' : '3'",
          "as": "badge"
        }
      ],
      "mark": {"type": "text", "fontSize": 15, "fontWeight": 700, "color": "#FFFFFF"},
      "encoding": {
        "x": {"field": "decade", "type": "ordinal"},
        "y": {
          "field": "camera_type",
          "type": "nominal",
          "sort": [
            "Plate & field",
            "Stereo",
            "Box",
            "Folding",
            "Reflex",
            "Roll film",
            "Movie (cine)",
            "Miniature",
            "35mm",
            "Compact",
            "Pocket",
            "Instant",
            "Digital",
            "Disposable"
          ]
        },
        "text": {"field": "badge"}
      }
    }
  ],
  "config": {
    "background": null,
    "view": {"fill": "#F1EEE7", "stroke": null},
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "axis": {
      "domain": false,
      "ticks": false,
      "grid": false,
      "labelColor": "#4A4A4A",
      "labelFontSize": 14,
      "labelPadding": 8
    },
    "legend": {
      "labelColor": "#4A4A4A",
      "labelFontSize": 12,
      "titleColor": "#4A4A4A",
      "titleFontSize": 13,
      "titleFontWeight": 600
    }
  }
}