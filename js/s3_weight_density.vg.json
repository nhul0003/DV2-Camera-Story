{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Density plot: weight of new digital camera models in three eras. Cameras got lighter during the boom, then heavier after phones took over everyday photos.",
  "title": {
    "text": "Weight of new camera models, by era",
    "subtitle": "Grams, including battery · 3,711 models with a listed weight"
  },
  "width": 647,
  "height": 300,
  "data": {"url": "data/cameras.csv", "format": {"parse": {"year": "number", "weight_g": "number"}}},
  "transform": [
    {"filter": "isValid(datum.weight_g) && datum.weight_g > 0"},
    {
      "calculate": "datum.year <= 2004 ? '1994–2004: early digital' : datum.year <= 2012 ? '2005–2012: the boom' : '2013–2025: the phone era'",
      "as": "era"
    }
  ],
  "layer": [
    {
      "transform": [
        {
          "density": "weight_g",
          "groupby": ["era"],
          "extent": [0, 1200],
          "bandwidth": 30,
          "steps": 240,
          "as": ["weight", "density"]
        },
        {"calculate": "datum.density * 10", "as": "share10"}
      ],
      "mark": {"type": "area", "opacity": 0.28, "interpolate": "monotone"},
      "encoding": {
        "x": {
          "field": "weight",
          "type": "quantitative",
          "scale": {"domain": [0, 1200], "nice": false},
          "title": "Weight with battery (grams)",
          "axis": {"values": [0, 200, 400, 600, 800, 1000, 1200], "grid": false, "labelPadding": 6}
        },
        "y": {
          "field": "share10",
          "type": "quantitative",
          "title": "Share of models in each 10 g step",
          "stack": null,
          "axis": {"format": "%", "values": [0, 0.02, 0.04, 0.06, 0.08], "grid": true, "gridColor": "#ECE8DF"}
        },
        "color": {
          "field": "era",
          "type": "nominal",
          "title": "Era (median weight)",
          "scale": {
            "domain": ["1994–2004: early digital", "2005–2012: the boom", "2013–2025: the phone era"],
            "range": ["#9CCDD2", "#1B7F8C", "#0B3F46"]
          },
          "legend": null
        },
        "opacity": {"condition": {"param": "era_pick", "empty": true, "value": 0.28}, "value": 0.03}
      }
    },
    {
      "transform": [
        {
          "density": "weight_g",
          "groupby": ["era"],
          "extent": [0, 1200],
          "bandwidth": 30,
          "steps": 240,
          "as": ["weight", "density"]
        },
        {"calculate": "datum.density * 10", "as": "share10"}
      ],
      "mark": {"type": "line", "strokeWidth": 2.5, "interpolate": "monotone"},
      "encoding": {
        "x": {"field": "weight", "type": "quantitative", "scale": {"domain": [0, 1200], "nice": false}},
        "y": {"field": "share10", "type": "quantitative"},
        "color": {
          "field": "era",
          "type": "nominal",
          "scale": {
            "domain": ["1994–2004: early digital", "2005–2012: the boom", "2013–2025: the phone era"],
            "range": ["#9CCDD2", "#1B7F8C", "#0B3F46"]
          },
          "legend": {
            "orient": "top-right",
            "direction": "vertical",
            "symbolType": "stroke",
            "symbolStrokeWidth": 4,
            "title": "Era (median weight)",
            "labelLimit": 320,
            "labelExpr": "datum.label + (indexof(datum.label, '1994') == 0 ? ' · 230 g' : indexof(datum.label, '2005') == 0 ? ' · 150 g' : ' · 370 g')",
            "titleLimit": 300
          }
        },
        "opacity": {"condition": {"param": "era_pick", "empty": true, "value": 1}, "value": 0.12}
      },
      "params": [{"name": "era_pick", "select": {"type": "point", "fields": ["era"]}, "bind": "legend"}]
    },
    {
      "transform": [
        {
          "aggregate": [{"op": "median", "field": "weight_g", "as": "med"}, {"op": "count", "as": "n"}],
          "groupby": ["era"]
        }
      ],
      "mark": {"type": "rule", "strokeDash": [4, 3], "strokeWidth": 1.5},
      "encoding": {
        "x": {"field": "med", "type": "quantitative", "scale": {"domain": [0, 1200], "nice": false}},
        "color": {
          "field": "era",
          "type": "nominal",
          "scale": {
            "domain": ["1994–2004: early digital", "2005–2012: the boom", "2013–2025: the phone era"],
            "range": ["#9CCDD2", "#1B7F8C", "#0B3F46"]
          },
          "legend": null
        },
        "tooltip": [
          {"field": "era", "title": "Era"},
          {"field": "med", "type": "quantitative", "title": "Median weight (g)"},
          {"field": "n", "type": "quantitative", "title": "Models with a weight", "format": ","}
        ],
        "opacity": {"condition": {"param": "era_pick", "empty": true, "value": 1}, "value": 0.12}
      }
    },
    {
      "data": {"values": [{"w": 185, "t1": "71% of boom-era models", "t2": "weighed 100–200 g"}]},
      "layer": [
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "y": 8,
            "dx": 6,
            "fontSize": 13,
            "fontWeight": 700,
            "color": "#1B7F8C",
            "stroke": "#FAF8F3",
            "strokeWidth": 5,
            "strokeJoin": "round"
          },
          "encoding": {
            "x": {"field": "w", "type": "quantitative", "scale": {"domain": [0, 1200], "nice": false}},
            "text": {"field": "t1"}
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "y": 25,
            "dx": 6,
            "fontSize": 13,
            "color": "#1B7F8C",
            "stroke": "#FAF8F3",
            "strokeWidth": 5,
            "strokeJoin": "round"
          },
          "encoding": {
            "x": {"field": "w", "type": "quantitative", "scale": {"domain": [0, 1200], "nice": false}},
            "text": {"field": "t2"}
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "y": 8,
            "dx": 6,
            "fontSize": 13,
            "fontWeight": 700,
            "color": "#1B7F8C"
          },
          "encoding": {
            "x": {"field": "w", "type": "quantitative", "scale": {"domain": [0, 1200], "nice": false}},
            "text": {"field": "t1"}
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "y": 25,
            "dx": 6,
            "fontSize": 13,
            "color": "#1B7F8C"
          },
          "encoding": {
            "x": {"field": "w", "type": "quantitative", "scale": {"domain": [0, 1200], "nice": false}},
            "text": {"field": "t2"}
          }
        }
      ]
    }
  ],
  "config": {
    "background": null,
    "view": {"stroke": null},
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "axis": {
      "domain": false,
      "ticks": false,
      "labelColor": "#4A4A4A",
      "titleColor": "#6B6B6B",
      "titleFontWeight": 600,
      "labelFontSize": 13
    },
    "legend": {
      "labelColor": "#4A4A4A",
      "titleColor": "#4A4A4A",
      "titleFontWeight": 600,
      "titleFontSize": 13,
      "labelFontSize": 13,
      "labelLimit": 300
    },
    "title": {
      "anchor": "start",
      "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "fontSize": 19,
      "fontWeight": 700,
      "color": "#1F1F1F",
      "subtitleFont": "'Source Sans 3', Helvetica, Arial, sans-serif",
      "subtitleFontSize": 14,
      "subtitleColor": "#6B6B6B",
      "subtitlePadding": 4,
      "offset": 14
    }
  },
  "padding": {"left": 0, "right": 8, "top": 5, "bottom": 5},
  "resolve": {"legend": {"color": "independent"}}
}