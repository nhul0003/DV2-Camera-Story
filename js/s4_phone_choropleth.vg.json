{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Choropleth map: share of people aged 10 and over who own a mobile phone, by country. Choose a year from 2019 to 2024.",
  "width": 1072,
  "height": 530,
  "autosize": {"type": "none"},
  "projection": {"type": "equalEarth", "rotate": [-150, 0, 0], "scale": 170, "translate": [536.0, 290.0]},
  "params": [
    {
      "name": "year_pick",
      "value": 2024,
      "bind": {"input": "radio", "options": [2019, 2020, 2021, 2022, 2023, 2024], "name": "Show year: "}
    }
  ],
  "layer": [
    {"data": {"sphere": true}, "mark": {"type": "geoshape", "fill": "#E3ECEF", "stroke": null}},
    {
      "data": {"graticule": {"step": [30, 30]}},
      "mark": {"type": "geoshape", "filled": false, "stroke": "#FFFFFF", "strokeWidth": 0.8}
    },
    {
      "data": {
        "url": "js/ne_110m_admin_0_countries.topojson",
        "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
      },
      "transform": [{"filter": "datum.properties.NAME != 'Antarctica'"}],
      "mark": {"type": "geoshape", "fill": "#EFECE5", "stroke": "#FAF8F3", "strokeWidth": 0.6}
    },
    {
      "data": {"url": "data/share-population-mobile-phone.csv"},
      "transform": [
        {"calculate": "toNumber(datum['Proportion of individuals who own a mobile telephone'])", "as": "own"},
        {"filter": "isValid(datum.Code) && length(datum.Code) == 3 && datum.Year == year_pick"},
        {"window": [{"op": "rank", "as": "rank"}], "sort": [{"field": "own", "order": "descending"}]},
        {"joinaggregate": [{"op": "count", "as": "n_countries"}]},
        {
          "lookup": "Code",
          "from": {
            "data": {
              "url": "js/ne_110m_admin_0_countries.topojson",
              "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
            },
            "key": "properties.ADM0_A3"
          },
          "as": "geo"
        },
        {"filter": "isValid(datum.geo)"},
        {
          "calculate": "datum.own < 50 ? 'Under 50%' : datum.own < 70 ? '50–69%' : datum.own < 85 ? '70–84%' : datum.own < 95 ? '85–94%' : '95% or more'",
          "as": "band"
        }
      ],
      "mark": {"type": "geoshape", "stroke": "#FAF8F3", "strokeWidth": 0.6},
      "encoding": {
        "shape": {"field": "geo", "type": "geojson"},
        "color": {
          "field": "band",
          "type": "ordinal",
          "title": "Own a mobile phone",
          "scale": {
            "domain": ["Under 50%", "50–69%", "70–84%", "85–94%", "95% or more"],
            "range": ["#E3E7EE", "#B8C2D3", "#8797B2", "#56688C", "#2C3A5A"]
          },
          "legend": {
            "orient": "none",
            "legendX": 0,
            "legendY": 72,
            "direction": "vertical",
            "symbolType": "square",
            "symbolSize": 160
          }
        },
        "tooltip": [
          {"field": "Entity", "title": "Country"},
          {"field": "Year", "type": "ordinal", "title": "Year"},
          {"field": "own", "type": "quantitative", "title": "Own a mobile phone (%)", "format": ".1f"},
          {"field": "rank", "type": "quantitative", "title": "Rank (of countries with data)"}
        ],
        "stroke": {"condition": {"test": "datum.Code == 'AUS'", "value": "#C23B22"}, "value": "#FAF8F3"},
        "strokeWidth": {"condition": {"test": "datum.Code == 'AUS'", "value": 2.2}, "value": 0.6},
        "order": {"condition": {"test": "datum.Code == 'AUS'", "value": 1}, "value": 0}
      }
    },
    {
      "data": {"url": "data/share-population-mobile-phone.csv"},
      "transform": [
        {"calculate": "toNumber(datum['Proportion of individuals who own a mobile telephone'])", "as": "own"},
        {"filter": "isValid(datum.Code) && length(datum.Code) == 3 && datum.Year == year_pick"},
        {"window": [{"op": "rank", "as": "rank"}], "sort": [{"field": "own", "order": "descending"}]},
        {"joinaggregate": [{"op": "count", "as": "n_countries"}]},
        {"filter": "datum.Code == 'AUS' || datum.rank == datum.n_countries"},
        {
          "lookup": "Entity",
          "from": {"data": {"url": "data/countryInfo.csv"}, "key": "name", "fields": ["latitude", "longitude"]}
        },
        {
          "calculate": "datum.Code == 'AUS' ? 'Australia ' + format(datum.own, '.1f') + '% · #' + datum.rank + ' of ' + datum.n_countries : 'Lowest: ' + datum.Entity + ' ' + format(datum.own, '.1f') + '%'",
          "as": "lab"
        },
        {"calculate": "datum.Code == 'AUS' ? 'aus' : 'low'", "as": "who"}
      ],
      "layer": [
        {
          "transform": [{"filter": "datum.who == 'aus'"}],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 70,
            "dy": 34,
            "fontSize": 13,
            "fontWeight": 700,
            "color": "#C23B22"
          },
          "encoding": {
            "longitude": {"field": "longitude", "type": "quantitative"},
            "latitude": {"field": "latitude", "type": "quantitative"},
            "text": {"field": "lab"}
          }
        },
        {
          "transform": [{"filter": "datum.who == 'low'"}],
          "mark": {"type": "text", "align": "right", "dx": -10, "fontSize": 13, "fontWeight": 700, "color": "#1F1F1F"},
          "encoding": {
            "longitude": {"field": "longitude", "type": "quantitative"},
            "latitude": {"field": "latitude", "type": "quantitative"},
            "text": {"field": "lab"}
          }
        },
        {
          "transform": [{"filter": "datum.who == 'low'"}],
          "mark": {
            "type": "point",
            "shape": "circle",
            "filled": false,
            "size": 120,
            "stroke": "#1F1F1F",
            "strokeWidth": 1.5
          },
          "encoding": {
            "longitude": {"field": "longitude", "type": "quantitative"},
            "latitude": {"field": "latitude", "type": "quantitative"}
          }
        }
      ]
    },
    {
      "data": {"url": "data/share-population-mobile-phone.csv"},
      "transform": [
        {"calculate": "toNumber(datum['Proportion of individuals who own a mobile telephone'])", "as": "own"},
        {"filter": "datum.Entity == 'World' && datum.Year == year_pick"},
        {
          "calculate": "datum.Year + ': ' + format(datum.own, '.0f') + '% of people worldwide own a mobile phone'",
          "as": "t1"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "text",
            "x": 0,
            "y": 12,
            "align": "left",
            "fontSize": 22,
            "fontWeight": 700,
            "font": "'Playfair Display', Georgia, serif",
            "color": "#1F1F1F"
          },
          "encoding": {"text": {"field": "t1"}}
        },
        {
          "mark": {"type": "text", "x": 0, "y": 38, "align": "left", "fontSize": 14, "color": "#3A3A3A"},
          "encoding": {
            "text": {
              "value": "Darker countries have a larger share of people with a phone; light beige means no data"
            }
          }
        }
      ]
    }
  ],
  "config": {
    "background": null,
    "view": {"stroke": null},
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif",
    "axis": {
      "domain": false,
      "ticks": false,
      "labelColor": "#4A4A4A",
      "titleColor": "#6B6B6B",
      "titleFontWeight": 600,
      "labelFontSize": 13
    },
    "legend": {
      "labelColor": "#4A4A4A",
      "titleColor": "#4A4A4A",
      "titleFontWeight": 600,
      "titleFontSize": 13,
      "labelFontSize": 13,
      "labelLimit": 320,
      "titleLimit": 320
    }
  },
  "padding": {"left": 0, "right": 0, "top": 0, "bottom": 0}
}
